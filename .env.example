# =============================================================================
# codex-fleet 配置示例
#
# 用法:cp .env.example .env,然后只填下面 [必填] 区块即可启动。
# [可选] 区块都已注释,需要时再取消注释覆盖默认值。
# =============================================================================


# -----------------------------------------------------------------------------
# [必填] 安全密钥 / 初始密码 —— 生产环境务必改成自己的值
# -----------------------------------------------------------------------------

# 加密主密钥,用来加密数据库里存的凭据(SSH key、第三方 token 等)。
# 一旦泄露 = 所有存的凭据可被解开。建议 32 字符以上随机串。
CODEX_MASTER_KEY=change-me-in-production-use-32-chars-min

# JWT 签名密钥,泄露 = 可伪造任意用户登录态。建议随机串。
JWT_SECRET=change-me-in-production-jwt-secret

# Postgres 密码。docker compose 起 pg 时会用它初始化数据库。
POSTGRES_PASSWORD=codexfleet

# 首次启动种子管理员账号的密码。仅在数据库里还没有该用户时生效,
# 之后改密码请在 UI 里操作,改这里没用。
INITIAL_ADMIN_PASSWORD=codex


# -----------------------------------------------------------------------------
# [可选] 应用运行参数 —— 默认值已够用,需要时取消注释
# -----------------------------------------------------------------------------

# HTTP 端口,默认 3000。端口冲突再改。
#PORT=3000

# 访问令牌有效期(分钟),默认 30。
#ACCESS_TOKEN_MINUTES=30

# 刷新令牌有效期(天),默认 30。
#REFRESH_TOKEN_DAYS=30

# 登录失败次数上限,达到后锁定账号,默认 5。
#MAX_LOGIN_FAILURES=5

# 账号锁定时长(分钟),默认 15。
#LOGIN_LOCK_MINUTES=15


# -----------------------------------------------------------------------------
# [可选] 初始管理员账号 —— 仅首次启动生效
# -----------------------------------------------------------------------------

#INITIAL_ADMIN_USERNAME=codex
#INITIAL_ADMIN_DISPLAY_NAME=Codex Admin


# -----------------------------------------------------------------------------
# [可选] 日志级别 —— 排错时把对应 crate 调成 debug
# -----------------------------------------------------------------------------

#RUST_LOG=backend=info,runtime_agent=info,iam=info,config_center=info,notification_center=info,shared_kernel=info,tower_http=info


# -----------------------------------------------------------------------------
# [可选] PostgreSQL —— 用 docker compose 起的 pg 基本不用动
# -----------------------------------------------------------------------------

# 数据库用户名 / 库名,改了要保证 app 和 pg 容器一致,没理由别动。
#POSTGRES_USER=codexfleet
#POSTGRES_DB=codexfleet

# 后端连数据库的地址 / 端口:
#   - 全 docker compose 部署 (docker-compose.yml):无需配置,compose 已用 postgres:5432 覆盖
#   - 只起 app 容器 (docker-compose.dev.yml) 或本地 cargo run:填外部 DB 的地址端口
#POSTGRES_HOST=
#POSTGRES_PORT=5432

# 后端 SQLx 连接池配置,高并发再调。pg 默认最大 100 连接。
#DB_MAX_CONNECTIONS=30
#DB_ACQUIRE_TIMEOUT_SECS=10
